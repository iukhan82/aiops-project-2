{
  "schema_version": "1.0.0",
  "description": "P08.01: the single source of truth for who may see and do what in the operator UI. The backend derives its role->capability matrix from this file (backend/api/authz.py), the frontend derives navigation and route guards from it, and tools/inventory.py proves it against docs/security/ROLES_AND_ACTION_AUTHORITY.md (roles) and the running FastAPI app's OpenAPI (endpoints).",
  "roles": {
    "operator": {
      "home": "map",
      "summary": "Traffic operations: watches the network, works incidents, requests SC-0/SC-1 actions (and, for SC-2, only as the requester)."
    },
    "supervisor": {
      "home": "actions-commands",
      "summary": "Traffic operations lead: approves SC-1/SC-2 commands as the second person, reviews outcomes, owns shift handover."
    },
    "dispatcher": {
      "home": "dispatch",
      "summary": "Emergency dispatch: takes calls, assigns units, requests SC-2 emergency actions such as signal pre-emption."
    },
    "incident_commander": {
      "home": "incidents",
      "summary": "Emergency command: approves SC-2 actions, works critical incidents. Override authority exists in P02.08 and is not in this UI (P09.05)."
    },
    "field_responder": {
      "home": "field",
      "summary": "In the field, read-only: sees the incident, assignment, route and ETA. Holds no REQUEST/APPROVE/EXECUTE/OVERRIDE."
    },
    "auditor": {
      "home": "audit",
      "summary": "Cross-domain, read-only: reads incidents, commands, policy decisions, outcomes and the audit trail. AUDIT never grants anything else."
    },
    "demo_operator": {
      "home": "demo",
      "summary": "Presentation only: starts/resets/replays simulated scenarios through the separate scenario-control API; can see the picture, never reaches the operational command path."
    }
  },
  "capabilities": {
    "map.view": {
      "description": "Live operations map, layers, replay, accessible list, live feed.",
      "roles": [
        "operator",
        "supervisor",
        "dispatcher",
        "incident_commander",
        "field_responder",
        "auditor",
        "demo_operator"
      ]
    },
    "analytics.view": {
      "description": "Corridor, intersection and device analytics, forecasts, detection candidates.",
      "roles": [
        "operator",
        "supervisor",
        "dispatcher",
        "incident_commander",
        "auditor",
        "demo_operator"
      ]
    },
    "incidents.view": {
      "description": "Incident list, detail, evidence and timeline.",
      "roles": [
        "operator",
        "supervisor",
        "dispatcher",
        "incident_commander",
        "field_responder",
        "auditor"
      ]
    },
    "incidents.manage": {
      "description": "Acknowledge, assign ownership, transition and annotate incidents.",
      "roles": [
        "operator",
        "supervisor",
        "incident_commander"
      ]
    },
    "emergency.view": {
      "description": "Emergency calls, unit assignments, route alternatives and status.",
      "roles": [
        "operator",
        "supervisor",
        "dispatcher",
        "incident_commander",
        "field_responder",
        "auditor"
      ]
    },
    "emergency.dispatch": {
      "description": "Create calls, assign units with routes, record call/assignment status.",
      "roles": [
        "dispatcher",
        "incident_commander"
      ]
    },
    "routes.view": {
      "description": "Fastest-safe route and ETA queries.",
      "roles": [
        "operator",
        "supervisor",
        "dispatcher",
        "incident_commander",
        "field_responder"
      ]
    },
    "recommendations.view": {
      "description": "System recommendations with predicted benefit, harm and safety bounds.",
      "roles": [
        "operator",
        "supervisor",
        "dispatcher",
        "incident_commander",
        "auditor"
      ]
    },
    "commands.view": {
      "description": "Commands, their policy decision, state history and errors.",
      "roles": [
        "operator",
        "supervisor",
        "dispatcher",
        "incident_commander",
        "auditor"
      ]
    },
    "commands.request": {
      "description": "Turn a recommendation or an operator judgement into a requested command (role and safety class enforced by policy).",
      "roles": [
        "operator",
        "dispatcher"
      ]
    },
    "commands.review": {
      "description": "Approve or deny a requested command (approver role and four-eyes enforced by policy).",
      "roles": [
        "operator",
        "supervisor",
        "incident_commander"
      ]
    },
    "outcomes.view": {
      "description": "Independent pre/post outcome verification and rollback evidence.",
      "roles": [
        "operator",
        "supervisor",
        "dispatcher",
        "incident_commander",
        "auditor"
      ]
    },
    "audit.view": {
      "description": "Unified append-only audit trail.",
      "roles": [
        "auditor"
      ]
    },
    "ops.view": {
      "description": "Platform status: service health, data freshness, ingestion.",
      "roles": [
        "operator",
        "supervisor",
        "incident_commander",
        "auditor"
      ]
    },
    "handover.view": {
      "description": "Shift handover notes.",
      "roles": [
        "operator",
        "supervisor",
        "dispatcher",
        "incident_commander",
        "field_responder",
        "auditor"
      ]
    },
    "handover.write": {
      "description": "Write and acknowledge shift handover notes.",
      "roles": [
        "operator",
        "supervisor",
        "dispatcher",
        "incident_commander"
      ]
    },
    "demo.control": {
      "description": "Start, replay and reset simulated scenarios (scenario-control API, separate from operations).",
      "roles": [
        "demo_operator"
      ]
    },
    "audit.export": {
      "description": "Export the audit trail as a redacted, attributed evidence bundle.",
      "roles": [
        "auditor"
      ]
    },
    "commands.override": {
      "description": "Countermand an executed SC-2 command before independent verification completes, with a mandatory justification. incident_commander only; no override exists for SC-0 or SC-1.",
      "roles": [
        "incident_commander"
      ]
    }
  },
  "common_states": [
    "loading",
    "empty",
    "error",
    "forbidden",
    "stale",
    "reconnecting"
  ],
