  "journeys": [
    {
      "role": "operator",
      "goal": "Notice a problem on the network, understand it, and get a safe action taken.",
      "steps": [
        {
          "screen": "map",
          "action": "Watch layers for congestion, closures and stale sensors; open the accessible list when the map is not the right tool."
        },
        {
          "screen": "incidents",
          "action": "Open the highest-severity unacknowledged incident.",
          "capability": "incidents.view"
        },
        {
          "screen": "incident-detail",
          "action": "Read evidence and ranked hypotheses; acknowledge and take ownership.",
          "capability": "incidents.manage"
        },
        {
          "screen": "actions-recommendations",
          "action": "Compare alternatives (benefit, harm, bounds); choose one and request it.",
          "capability": "commands.request"
        },
        {
          "screen": "actions-command-detail",
          "action": "Follow the command through approval, execution and the verified outcome."
        }
      ],
      "failure_cases": [
        "live feed drops: the map says it is reconnecting and shows the age of every value",
        "a target has no fresh evidence: the command is denied as stale_evidence and says why",
        "the policy engine is down: the command stays requested and is labelled policy unavailable, never approved"
      ]
    },
    {
      "role": "supervisor",
      "goal": "Be the second person: approve or refuse what an operator requested, and verify it worked.",
      "steps": [
        {
          "screen": "actions-commands",
          "action": "Open the pending-approval queue (home).",
          "capability": "commands.view"
        },
        {
          "screen": "actions-command-detail",
          "action": "Read target, reason, expected effect, constraints and expiry; approve or deny with a recorded reason after an explicit confirmation.",
          "capability": "commands.review"
        },
        {
          "screen": "actions-outcomes",
          "action": "Check the independent outcome; an unsafe outcome shows the rollback and the physical undo evidence.",
          "capability": "outcomes.view"
        },
        {
          "screen": "handover",
          "action": "Write the shift handover with open items.",
          "capability": "handover.write"
        }
      ],
      "failure_cases": [
        "approving your own request: refused by policy and shown as four-eyes, not hidden",
        "the command expired while open: shown as expired, approval disabled"
      ]
    },
    {
      "role": "dispatcher",
      "goal": "Get the right unit to the scene by the fastest safe route.",
      "steps": [
        {
          "screen": "dispatch",
          "action": "Take or open a call (home); create one when it arrives.",
          "capability": "emergency.dispatch"
        },
        {
          "screen": "dispatch-detail",
          "action": "Compare route alternatives with ETA and uncertainty; assign the unit; record status changes.",
          "capability": "emergency.dispatch"
        },
        {
          "screen": "actions-commands",
          "action": "Request signal pre-emption for the selected route (SC-2, needs a second person).",
          "capability": "commands.request"
        },
        {
          "screen": "dispatch-detail",
          "action": "Watch the unit and the pre-emption command until the unit is on scene."
        }
      ],
      "failure_cases": [
        "no open route: the screen says so and asks for a human decision; nothing is guessed",
        "the unit becomes unavailable: the call stays open and can be reassigned"
      ]
    },
    {
      "role": "incident_commander",
      "goal": "Own critical incidents and approve safety-critical emergency actions.",
      "steps": [
        {
          "screen": "incidents",
          "action": "Open the critical queue (home).",
          "capability": "incidents.view"
        },
        {
          "screen": "incident-detail",
          "action": "Escalate, assign and annotate; see linked recommendations and commands.",
          "capability": "incidents.manage"
        },
        {
          "screen": "actions-commands",
          "action": "Approve an SC-2 command requested by someone else.",
          "capability": "commands.review"
        }
      ],
      "failure_cases": [
        "requesting and approving as the same person: refused, four-eyes holds for commanders too"
      ]
    },
    {
      "role": "field_responder",
      "goal": "Know where to go, by which route, when to arrive, and what changed.",
      "steps": [
        {
          "screen": "field",
          "action": "Read the assigned call, route, ETA and status (home). Read-only on purpose.",
          "capability": "emergency.view"
        }
      ],
      "failure_cases": [
        "connectivity lost: the view says offline and shows the age of what it last had, never presenting it as live"
      ]
    },
    {
      "role": "auditor",
      "goal": "Reconstruct who did what, when, and under which policy decision.",
      "steps": [
        {
          "screen": "audit",
          "action": "Filter the append-only trail by actor, entity and time (home).",
          "capability": "audit.view"
        },
        {
          "screen": "actions-commands",
          "action": "Open a command and read its policy decision, roles and state history.",
          "capability": "commands.view"
        },
        {
          "screen": "actions-outcomes",
          "action": "Read the independent outcome and any rollback evidence.",
          "capability": "outcomes.view"
        }
      ],
      "failure_cases": [
        "an attempt to act: every control is absent, not merely disabled, because the role holds none of REQUEST/APPROVE/EXECUTE/OVERRIDE"
      ]
    },
    {
      "role": "demo_operator",
      "goal": "Run a simulated scenario for a presentation without touching operations.",
      "steps": [
        {
          "screen": "demo",
          "action": "Start, replay or reset a scenario (home), under a permanent 'simulated' banner.",
          "capability": "demo.control"
        },
        {
          "screen": "map",
          "action": "Show the picture the scenario produced.",
          "capability": "map.view"
        }
      ],
      "failure_cases": [
        "too many concurrent runs: the bound is shown, not hidden"
      ]
    }
  ],
  "_comment_api": "`api` = calls every role that may open the screen is allowed to make; `optional_api` = calls made only when the signed-in role also holds that API's capability (the layer or control is absent otherwise)."
}
