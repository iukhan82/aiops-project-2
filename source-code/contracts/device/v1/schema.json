{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project2.local/contracts/device/v1/schema.json",
  "title": "Device and capability registration",
  "description": "Identity, type, location, ownership, capability, certificate and configuration record for one edge device or simulated device, per REFERENCE_ARCHITECTURE.md section 4.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "device_id",
    "device_type",
    "deployment_type",
    "agency_scope",
    "location",
    "capabilities",
    "status",
    "registered_at",
    "privacy_classification",
    "retention_class"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "description": "Semantic version of this contract; must match the version directory major."
    },
    "device_id": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$",
      "description": "Stable, project-unique device identifier. Never reused after decommission."
    },
    "device_type": {
      "type": "string",
      "enum": [
        "inductive_loop",
        "magnetometer",
        "radar",
        "lidar",
        "edge_camera",
        "bluetooth_wifi_sensor",
        "connected_vehicle_gateway",
        "weigh_in_motion",
        "probe_feed",
        "crossing_detector",
        "push_button_controller",
        "cycle_counter",
        "accessible_crossing_device",
        "signal_controller",
        "variable_message_sign",
        "weather_station",
        "road_condition_sensor",
        "transit_vehicle_gateway",
        "parking_sensor",
        "emergency_cad_avl_adapter",
        "operator_report_intake",
        "aiops_agent"
      ],
      "description": "Device category, drawn from docs/SENSOR_AND_DATA_CATALOG.md."
    },
    "deployment_type": {
      "type": "string",
      "enum": ["simulated", "real"],
      "description": "Whether this device is a SUMO-driven simulated entity or a real integration. Real devices are not authorized in this project yet; see AGENTS.md."
    },
    "agency_scope": {
      "type": "string",
      "minLength": 1,
      "description": "Owning tenant/agency scope for multi-agency separation, e.g. 'city-traffic-ops' or 'fire-dispatch'."
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geometry_version", "coordinate_reference", "latitude", "longitude"],
      "properties": {
        "geometry_version": {
          "type": "string",
          "minLength": 1,
          "description": "Version identifier of the road-network/geometry snapshot this location is valid against."
        },
        "coordinate_reference": {
          "type": "string",
          "const": "EPSG:4326"
        },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "intersection_id": { "type": "string" },
        "corridor_id": { "type": "string" },
        "lane_id": { "type": "string" }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "description": "Measurement or actuation types this device can produce or accept, e.g. 'vehicle_count', 'spat_state'."
    },
    "certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint_sha256", "not_before", "not_after"],
      "properties": {
        "fingerprint_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "not_before": { "type": "string", "format": "date-time" },
        "not_after": { "type": "string", "format": "date-time" }
      },
      "description": "mTLS device-identity certificate bound to this device_id, required before real deployment; optional while simulated devices use a shared development CA fixture."
    },
    "configuration_version": {
      "type": "string",
      "minLength": 1,
      "description": "Version of the device's applied configuration/firmware profile."
    },
    "status": {
      "type": "string",
      "enum": ["active", "inactive", "maintenance", "decommissioned"]
    },
    "registered_at": { "type": "string", "format": "date-time" },
    "privacy_classification": {
      "type": "string",
      "enum": ["none", "aggregated", "pseudonymous", "sensitive"]
    },
    "retention_class": {
      "type": "string",
      "enum": ["short", "standard", "extended", "audit"]
    }
  }
}
