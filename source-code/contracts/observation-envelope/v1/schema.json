{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project2.local/contracts/observation-envelope/v1/schema.json",
  "title": "Observation and event envelope",
  "description": "Common envelope for every telemetry/observation event, per docs/SENSOR_AND_DATA_CATALOG.md section 9 and docs/PROJECT_CONTEXT.md engineering invariants. Type-specific measurement catalogs (P03.03) populate the generic 'measurements' array.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "device_id",
    "agency_scope",
    "observation_time",
    "ingest_time",
    "sequence_number",
    "clock_quality",
    "geometry_version",
    "location",
    "measurements",
    "truth_label",
    "privacy_classification",
    "retention_class"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "description": "Semantic version of this contract; must match the version directory major."
    },
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Globally unique event identifier, generated by the producing device or edge adapter."
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$",
      "description": "Dotted event category, e.g. 'traffic.loop_detector.count' or 'weather.station.reading'."
    },
    "device_id": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$",
      "description": "References a device/v1 record's device_id."
    },
    "agency_scope": {
      "type": "string",
      "minLength": 1
    },
    "observation_time": {
      "type": "string",
      "format": "date-time",
      "description": "UTC time the phenomenon was observed at the source, distinct from ingest_time."
    },
    "ingest_time": {
      "type": "string",
      "format": "date-time",
      "description": "UTC time the event was accepted by central ingestion."
    },
    "sequence_number": {
      "type": "integer",
      "minimum": 0,
      "description": "Monotonic per-device sequence number, used for gap/duplicate/out-of-order detection."
    },
    "clock_quality": {
      "type": "string",
      "enum": ["synced", "drifting", "unknown"]
    },
    "geometry_version": {
      "type": "string",
      "minLength": 1,
      "description": "Version of the road-network/geometry snapshot this event's location references."
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinate_reference", "latitude", "longitude"],
      "properties": {
        "coordinate_reference": { "type": "string", "const": "EPSG:4326" },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "intersection_id": { "type": "string" },
        "corridor_id": { "type": "string" },
        "lane_id": { "type": "string" }
      }
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value", "unit", "quality", "confidence"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "value": { "type": ["number", "string", "boolean"] },
          "unit": {
            "type": "string",
            "minLength": 1,
            "description": "SI or explicitly named unit, e.g. 'm_s-1', 'count', 'celsius', 'boolean'."
          },
          "quality": {
            "type": "string",
            "enum": ["valid", "suspect", "invalid"]
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      },
      "description": "One or more named, unit-tagged measurement values carried by this event."
    },
    "truth_label": {
      "type": "string",
      "enum": ["simulated", "measured", "inferred", "predicted", "operator_entered", "verified"],
      "description": "Epistemic status of this event's values, per docs/PROJECT_CONTEXT.md."
    },
    "privacy_classification": {
      "type": "string",
      "enum": ["none", "aggregated", "pseudonymous", "sensitive"]
    },
    "retention_class": {
      "type": "string",
      "enum": ["short", "standard", "extended", "audit"]
    },
    "correlation_id": {
      "type": "string",
      "description": "Optional trace/correlation identifier linking related events across services."
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "producer": { "type": "string", "minLength": 1 },
        "pipeline_version": { "type": "string", "minLength": 1 },
        "source_event_ids": {
          "type": "array",
          "items": { "type": "string", "format": "uuid" }
        }
      },
      "description": "Optional lineage for derived/aggregated events; omitted for raw device observations."
    }
  }
}
