# Copy to .env (git-ignored) before running docker compose. These are local
# development-fixture credentials only, never used past this dev route; the
# assessment target uses K3s-managed secrets (P09.04), not this file.

POSTGRES_DB=aiops
POSTGRES_USER=aiops_app
POSTGRES_PASSWORD=change-me-local-dev-only

# Keycloak (P09.02, pulled forward for P08.04). Generate the password with
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# Demo user passwords are NOT set here: keycloak/provision.py generates them
# at provisioning time into a git-ignored output file.
KEYCLOAK_ADMIN=kcadmin
KEYCLOAK_ADMIN_PASSWORD=change-me-local-dev-only

# Grafana (P10.03), same local-dev-only scope as the credentials above.
GRAFANA_ADMIN_PASSWORD=change-me-local-dev-only
